<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pl</string>
	<key>CFBundleDisplayName</key>
	<string>Emma</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Deklaracja eksportowa: aplikacja używa wyłącznie szyfrowania systemu
	     (HTTPS/TLS, pęk kluczy), które jest zwolnione z dokumentacji eksportowej.
	     Bez tego klucza każdy build w TestFlight stoi na „Missing Compliance”. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Rejestracja czcionek. Bez tego wpisu pliki .ttf są w pakiecie, ale
	     UIFont(name:) ich nie znajdzie — dokładnie taką sytuację wykrywa
	     EmmaFontRegistration.verifyRegisteredFonts() przy starcie.
	     Nazwy plików muszą być zgodne z tymi w Resources/Fonts. -->
	<key>UIAppFonts</key>
	<array>
		<string>DMSans-Regular.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMSans-SemiBold.ttf</string>
		<string>Manrope-Bold.ttf</string>
		<string>Manrope-ExtraBold.ttf</string>
	</array>

	<!-- Konfiguracja bez sekretów, wstrzykiwana z plików .xcconfig. -->
	<key>EMMAEnvironment</key>
	<string>$(EMMA_ENVIRONMENT)</string>
	<key>EMMAApiBaseURL</key>
	<string>$(EMMA_API_BASE_URL)</string>
	<key>EMMADefaultLocale</key>
	<string>$(EMMA_DEFAULT_LOCALE)</string>
	<key>EMMAVoiceProvider</key>
	<string>$(EMMA_VOICE_PROVIDER)</string>
	<key>EMMAVoiceModel</key>
	<string>$(EMMA_VOICE_MODEL)</string>

	<!-- Uprawnienia pobierane przy pierwszym użyciu funkcji, nie przy starcie (§5.7).
	     Mikrofon opisuje rozmowę z Emmą, nie nagrywanie w tle. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Mikrofon jest używany wyłącznie po dotknięciu przycisku, aby rozmawiać z Emmą albo podyktować tekst. Nagranie nie jest zapisywane w aplikacji.</string>
	<key>NSCameraUsageDescription</key>
	<string>Aparat służy wyłącznie do skanowania dokumentów do akt sprawy (wezwania, postanowienia, pełnomocnictwa). Skan trafia do akt dopiero po dotknięciu „Zapisz w aktach”.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID odblokowuje aplikację po powrocie do niej. Zamiast Face ID możesz zawsze użyć hasła urządzenia.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Rozpoznawanie mowy zamienia wypowiedziane zdanie na tekst w polu wiadomości, notatki lub zadania. Użyj tekstu, jeśli nie chcesz korzystać z mikrofonu.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>pl.emma.quick.event</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Nowy termin</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>calendar.badge.plus</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>pl.emma.quick.task</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Nowe zadanie</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>checklist</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>pl.emma.quick.voice</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Porozmawiaj z Emmą</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>mic.fill</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- Pierwszy release: jasny motyw także przy ciemnym ustawieniu systemu (§2.3). -->
</dict>
</plist>
