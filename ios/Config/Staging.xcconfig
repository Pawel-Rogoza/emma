// Konfiguracja Staging — przeznaczona do testów z backendem.
// Wpisujemy tu wyłącznie adres HTTPS. Klucze dostawcy i innych usług
// NIE wpisujemy do Xcode ani do tego pliku — pozostają wyłącznie na serwerze (§1.8).

#include? "Local.xcconfig"

EMMA_BUNDLE_ID = pl.kancelaria.emma.staging
EMMA_ENVIRONMENT = staging

// Osobne środowisko staging jeszcze nie istnieje, więc wskazujemy ten sam host
// co Production. Gdy powstanie odrębny backend staging, podmieniamy tylko tę linię.
// `$()` łamie `//`, bo w xcconfig rozpoczyna ono komentarz.
EMMA_API_BASE_URL = https:/$()/advokat-varshava.pl

EMMA_DEVELOPMENT_TEAM = QZ25N94YZ8
EMMA_DEFAULT_LOCALE = pl
EMMA_VOICE_PROVIDER = gemini_live
EMMA_VOICE_MODEL = gemini-3.8-live
