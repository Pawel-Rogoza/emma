// WZÓR pliku lokalnego. Skopiuj jako Local.xcconfig i uzupełnij u siebie.
// Local.xcconfig jest w .gitignore — nie trafia do repozytorium.
//
//   cp Config/Local.xcconfig.example Config/Local.xcconfig
//
// Tu wpisuje się wyłącznie identyfikator zespołu Apple i ewentualnie adres backendu.
// Nie wpisuje się tu żadnych kluczy API dostawców.

EMMA_DEVELOPMENT_TEAM = ABCDE12345
EMMA_API_BASE_URL = https://example.invalid

// Dostawca rozmowy głosowej: elevenlabs (domyślnie) albo gemini_live.
// Backend musi mieć tę samą wartość w EMMA_VOICE_PROVIDER — inaczej wyda token
// innego dostawcy, a aplikacja zgłosi rozjazd zamiast udawać, że działa.
EMMA_VOICE_PROVIDER = elevenlabs
EMMA_VOICE_MODEL = gemini-3.8-live
