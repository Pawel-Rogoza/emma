// Konfiguracja Production — docelowa.
// Brak sekretów. Klucze dostawców pozostają na serwerze (§1.8, §13).

#include? "Local.xcconfig"

EMMA_BUNDLE_ID = pl.kancelaria.emma
EMMA_ENVIRONMENT = production
// Wartość składamy przez `$()`, bo w xcconfig `//` rozpoczyna komentarz i
// dosłowne `https://…` zostałoby obcięte do `https:`.
EMMA_API_BASE_URL = https:/$()/advokat-varshava.pl
EMMA_DEVELOPMENT_TEAM = QZ25N94YZ8
EMMA_DEFAULT_LOCALE = pl
